{
  "name": "@buildgraph/studio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "description": "BuildGraph Studio — the design canvas over the engineering core. Zero-runtime-dependency Node server and a dependency-free browser UI.",
  "scripts": {
    "start": "node server.ts",
    "dev": "node --watch server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "dependencies": {
    "@buildgraph/engineering-core": "*",
    "three": "^0.160.1",
    "web-ifc": "^0.0.57"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
