# BuildGraph Studio — configuration.
# Copy to .env and load it however you prefer (`node --env-file=.env apps/studio/server.ts`,
# a systemd unit, a container runtime). Every value here is a default unless noted.

# ---------------------------------------------------------------- networking
# Loopback by default. Set 0.0.0.0 only when a reverse proxy terminates TLS in front.
HOST=127.0.0.1
PORT=4317

# Enables production behaviour: registration closed by default, session secret required.
NODE_ENV=development

# Set when TLS is terminated upstream, so session cookies are still issued with `Secure`.
BG_BEHIND_TLS_PROXY=false

# ------------------------------------------------------------------- security
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development an ephemeral one is generated per process, so restarting signs everyone out.
BG_SESSION_SECRET=

# `accounts` (default) requires a signed-in user for every API call.
# `open` skips authentication entirely and is refused on any non-loopback host — evaluation only.
BG_AUTH_MODE=accounts

# Whether new accounts can be created. Defaults to true in development, false in production.
BG_ALLOW_REGISTRATION=true

# How long a session stays valid.
BG_SESSION_TTL_HOURS=12

# ------------------------------------------------------------------ storage
# Accounts, sessions, live documents and saved projects. Back this up.
BG_DATA_DIR=./apps/studio/data

# -------------------------------------------------------------- design copilot
# Without a key the assistant answers deterministically from the engine.
# With one, a model is given read-only tools over the same engine — it still cannot
# originate a number, only phrase what the engine computed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
BG_AI_TIMEOUT_MS=60000

# ------------------------------------------------------------------- limits
# Raise or lower to suit the deployment. Defaults shown.
BG_MAX_JSON_BYTES=1000000
BG_MAX_MESH_BYTES=24000000
BG_MAX_EVENTS_PER_REQUEST=2000
BG_MAX_EVENTS_PER_DOCUMENT=100000
BG_MAX_DOCUMENTS_IN_MEMORY=200
BG_MAX_PROJECTS_PER_WORKSPACE=200
BG_MAX_CUSTOM_CATALOG_ITEMS=2000
BG_MAX_SSE_CLIENTS=25
